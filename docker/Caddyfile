{
	# 本文件是 bundle 自带的最小入口。已有 nginx/traefik/caddy 的，把下面两个 handle
	# 抄成 6 行片段即可（见 docs/deployment-and-lume-api.md 的"接入已有反代"）。
	auto_https off
}

:80 {
	encode zstd gzip

	# 扩展 API 必须与 UI 同源：dufs 自己不会反代任何路径，这两条路由只能由入口层给。
	# 走共享卷里的 unix socket（lume-info-api 容器写 /shared/lume-info.sock，本容器挂同一个卷），
	# 所以没有任何对内端口；换回 TCP 就写 reverse_proxy lume-info-api:8090。
	handle /__lume__/info {
		reverse_proxy unix//shared/lume-info.sock
	}
	handle /__lume__/thumb {
		reverse_proxy unix//shared/lume-info.sock
	}

	handle {
		reverse_proxy dufs:5000
	}
}
