# 只有这两项是必填的
DATA_DIR=/srv/dufs-data          # 网盘数据根：dufs 的 /data，也是缩略图能读到的全部范围
LUME_HTTP_PORT=8080              # 对外入口端口

# 入口绑定地址：默认只绑回环（前面再挂 TLS 反代时用）。想直接对外改成 0.0.0.0
LUME_BIND=127.0.0.1

# 品牌：留空即用主题内置默认，不需要重新构建
LUME_TITLE=
LUME_SUBTITLE=
LUME_ICON=                       # 图标 URL：用绝对地址（https://…），或放一份在你 DATA_DIR 里后用它的访问路径（如 /brand/logo.svg）；镜像自带的 favicon 在 /__dufs_v<版本>__/ 下，版本号会变，不建议指它
LUME_LOGIN_URL=                  # 「前往登录」按钮指向的地址；留空 = 不显示该按钮

# 缩略图后端：vips（默认）| im | none（不装图像工具，前端自动退回原图直出）
IMAGE_TOOL=vips

# ─────────────────────────────────────────────────────────────
# dufs 自身的开关：整份 .env 会透传给 dufs 容器，而 dufs 0.47 起
# 每个命令行选项都有一个 DUFS_ 前缀的环境变量（见上游 README
# §Environment variables），所以下面这些**要用就取消注释，不要留空值**。
#
# ⚠ 留一行 `DUFS_AUTH=`（空但存在）会被 dufs 当成一条鉴权规则，
#   匿名请求立刻全站 401 —— 容器实测。要么注释掉，要么给真值。
#
# DUFS_AUTH=admin:secret@/:rw                 # dufs 自带 basic/digest 鉴权
# DUFS_ALLOW_UPLOAD=true                      # 允许上传（默认全只读）
# DUFS_ALLOW_DELETE=true
# DUFS_ALLOW_SEARCH=true                      # 不开的话匿名者搜不到东西
# DUFS_ALLOW_ARCHIVE=true                     # 文件夹打包下载 ?zip
# DUFS_PATH_PREFIX=/files                     # 挂在子路径下时
# DUFS_HIDDEN=tmp,*.log,.*

# ─────────────────────────────────────────────────────────────
# 高级项，一般不用动
DUFS_VERSION=v0.47.0            # 上游 dufs 镜像 tag（带 v 前缀；Hub 上没有 0.47.0 这种写法）
LUME_ANON_PREFIX=/share         # 公开区前缀：只影响带 scope=share 的请求（反代在匿名侧硬塞这个参数时才生效）
